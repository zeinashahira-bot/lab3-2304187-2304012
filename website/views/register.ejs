<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account - Database Lab 3</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="card">
        <h2>Create Account</h2>

        <form action="/register" method="POST" data-check novalidate>
            <ul class="errors js-errors" <%= errors.length === 0 ? 'hidden' : '' %>>
                <% errors.forEach(function (message) { %>
                    <li><%= message %></li>
                <% }) %>
            </ul>

            <div class="field">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" placeholder="Enter your name"
                       value="<%= values.name || '' %>" data-required="Name is required"
                       data-max="100" data-maxmsg="Name is too long (100 characters at most)"
                       data-pattern="^[\p{L}][\p{L} '.-]*$" data-patternmsg="Name contains invalid characters">
            </div>

            <div class="field">
                <label for="email">Email Address:</label>
                <input type="email" id="email" name="email" placeholder="Enter your email"
                       value="<%= values.email || '' %>" data-required="Email is required"
                       data-max="255" data-maxmsg="Email is too long (255 characters at most)"
                       data-pattern="^[^\s@]+@[^\s@]+\.[^\s@]+$" data-patternmsg="Email is not valid">
            </div>

            <div class="field">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" placeholder="At least 8 characters"
                       data-required="Password is required"
                       data-min="8" data-minmsg="Password must be at least 8 characters">
            </div>

            <div class="field">
                <label for="confirm_password">Confirm Password:</label>
                <input type="password" id="confirm_password" name="confirm_password" placeholder="Type it again"
                       data-required="Confirm password is required">
            </div>

            <button type="submit" class="btn btn-full">Register</button>
        </form>

        <p class="link">Already have an account? <a href="/login">Login here</a></p>
    </div>
    <script src="/validate.js"></script>
</body>
</html>