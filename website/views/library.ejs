<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library - Database Lab 3</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="card wider">
        <div class="topbar">
            <h2>Library</h2>
            <form action="/logout" method="POST">
                <span>Hi, <%= userName %></span>
                <button type="submit" class="btn btn-light">Log out</button>
            </form>
        </div>

        <% if (errors.length > 0) { %>
            <ul class="errors">
                <% errors.forEach(function (message) { %>
                    <li><%= message %></li>
                <% }) %>
            </ul>
        <% } %>

        <h3>Authors</h3>
        <div class="table-wrap">
            <table>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Country</th>
                    <th>Photo</th>
                    <th>Actions</th>
                </tr>
                <% authors.forEach(function (author) { %>
                    <tr>
                        <td><%= author.author_id %></td>
                        <td><input type="text" name="name" value="<%= author.name %>" form="edit-author-<%= author.author_id %>"></td>
                        <td><input type="text" name="country" value="<%= author.country %>" form="edit-author-<%= author.author_id %>"></td>
                        <td>
                            <% if (author.photo) { %>
                                <img src="<%= author.photo %>" width="50" alt="Author Photo">
                            <% } %>
                        </td>
                        <td class="actions">
                            <form id="edit-author-<%= author.author_id %>" action="/authors/<%= author.author_id %>/edit" method="POST"></form>
                            <button type="submit" class="btn btn-light" form="edit-author-<%= author.author_id %>">Save</button>
                            <form action="/authors/<%= author.author_id %>/delete" method="POST"
                                  onsubmit="return confirm('Delete this author and all of their books?');">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </table>
        </div>
        <% if (authors.length === 0) { %>
            <p class="empty">No authors yet. Add one below!</p>
        <% } %>

        <form action="/authors/add" method="POST" enctype="multipart/form-data" class="add-form">
            <input type="number" name="author_id" placeholder="Author ID" required>
            <input type="text" name="name" placeholder="Name" required>
            <input type="text" name="country" placeholder="Country" required>
            <input type="file" name="photo">
            <button type="submit" class="btn">Add author</button>
        </form>

        <h3>Books</h3>
        <div class="table-wrap">
            <table>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Price</th>
                    <th>Author ID</th>
                    <th>Cover</th>
                    <th>Actions</th>
                </tr>
                <% books.forEach(function (book) { %>
                    <tr>
                        <td><%= book.book_id %></td>
                        <td><input type="text" name="title" value="<%= book.title %>" form="edit-book-<%= book.book_id %>"></td>
                        <td><input type="number" step="0.01" name="price" value="<%= book.price %>" form="edit-book-<%= book.book_id %>"></td>
                        <td><input type="number" name="author_id" value="<%= book.author_id %>" form="edit-book-<%= book.book_id %>"></td>
                        <td>
                            <% if (book.cover) { %>
                                <img src="<%= book.cover %>" width="50" alt="Book Cover">
                            <% } %>
                        </td>
                        <td class="actions">
                            <form id="edit-book-<%= book.book_id %>" action="/books/<%= book.book_id %>/edit" method="POST"></form>
                            <button type="submit" class="btn btn-light" form="edit-book-<%= book.book_id %>">Save</button>
                            <form action="/books/<%= book.book_id %>/delete" method="POST"
                                  onsubmit="return confirm('Are you sure you want to delete this book?');">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </table>
        </div>
        <% if (books.length === 0) { %>
            <p class="empty">No books yet. Add one below!</p>
        <% } %>

        <form action="/books/add" method="POST" enctype="multipart/form-data" class="add-form">
            <input type="number" name="book_id" placeholder="Book ID" required>
            <input type="text" name="title" placeholder="Title" required>
            <input type="number" step="0.01" name="price" placeholder="Price" required>
            <input type="number" name="author_id" placeholder="Author ID" required>
            <input type="file" name="cover">
            <button type="submit" class="btn">Add book</button>
        </form>
    </div>
</body>
</html>